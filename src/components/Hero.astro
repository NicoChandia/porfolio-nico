---
import Badge from "@/components/Badge.astro"
import SocialPill from "@/components/SocialPill.astro"
import GitHubIcon from "@/components/icons/GitHub.astro"
import LinkedInIcon from "@/components/icons/LinkedIn.astro"
import MailIcon from "@/components/icons/Mail.astro"

// Cuando tengas el CV, guardalo en /public (ej: /public/cv-nicolas-chandia.pdf)
// y poné la ruta acá. Mientras esté vacío, el botón no se muestra.
const CV_URL = "/cv-nicolas-chandia.pdf"
---

<div class="grid items-center gap-12 md:grid-cols-[1.35fr_1fr] md:gap-14">
  <div>
    <a
      href="https://www.linkedin.com/in/nicolas-chandia-oyarzo/"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Disponible para trabajar: ver mi perfil de LinkedIn"
      class="hover:opacity-80 transition"
    >
      <Badge>disponible para trabajar</Badge>
    </a>

    <h1 class="mt-5 mb-6 text-4xl font-bold leading-[1.05] tracking-tight sm:text-5xl lg:text-6xl text-balance">
      De programar tornos CNC a <span class="text-accent">automatizar con IA</span>.
    </h1>

    <p class="max-w-xl text-lg leading-relaxed text-muted text-pretty">
      Soy <strong class="font-semibold text-fg">Nicolás Chandia</strong>, desarrollador de software en
      Río Negro, Argentina. Construyo sistemas con Angular, Node y n8n, y hoy exploro visión por
      computadora para la industria de la región.
    </p>

    <nav class="flex flex-wrap gap-3 mt-8">
      <SocialPill href="#proyectos" primary>Ver proyectos</SocialPill>
      <SocialPill href="https://github.com/NicoChandia">
        <GitHubIcon class="size-5" />
        GitHub
      </SocialPill>
      {CV_URL && (
        <SocialPill href={CV_URL} download="CV-Nicolas-Chandia.pdf">
          <svg class="size-4" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3v12m0 0-4-4m4 4 4-4M5 21h14"/></svg>
          Descargar CV
        </SocialPill>
      )}
      <SocialPill href="https://www.linkedin.com/in/nicolas-chandia-oyarzo/">
        <LinkedInIcon class="size-4" />
        LinkedIn
      </SocialPill>
      <SocialPill href="#contacto">
        <MailIcon class="size-4" />
        Email
      </SocialPill>
    </nav>
  </div>

  <div class="relative justify-self-center">
    <img
      class="object-cover border w-60 h-72 sm:w-72 sm:h-80 rounded-2xl border-line"
      src="/nicoch.webp"
      alt="Foto de Nicolás Chandia"
      width="400"
      height="400"
      fetchpriority="high"
    />
    <div
      class="absolute px-3 py-2 font-mono text-xs border shadow-lg -bottom-4 -left-6 sm:-left-8 rounded-xl bg-surface border-line text-muted whitespace-nowrap"
    >
      <b class="text-accent" title="Técnico Superior">Téc. Sup.</b> en Desarrollo de Software
    </div>
  </div>
</div>
