---
import ExperienceItem from "./ExperienceItem.astro"

/*
  Cada entrada puede tener:
  - description: un párrafo.
  - bullets: opcional, lista de puntos que se muestra debajo del párrafo.
*/
const EXPERIENCE = [
  {
    date: "2025 · Actualidad",
    title: "Docente de Programación y Desarrollo Web",
    company: "Escuela Técnica CET N°30 · Cipolletti, Río Negro",
    description:
      "Dicto cinco materias técnicas a más de 70 estudiantes de 4.º y 5.º año.",
    bullets: [
      "<strong>Desarrollo Web 1 y 2:</strong> HTML, CSS y Flexbox; TypeScript, Angular, Angular Material y Bootstrap, con proyectos grupales de componentes reutilizables.",
      "<strong>Programación:</strong> diseñé y dicté un curso intensivo de nivelación en JavaScript y hoy estoy a cargo de la materia: desde variables y condicionales hasta bucles, arreglos y objetos.",
      "<strong>Ingeniería de Software:</strong> Scrum, requisitos funcionales y no funcionales, ciclo de vida, UX/UI, testing y documentación.",
      "<strong>Sistemas de Información:</strong> datos e información, modelado y UML.",
    ],
  },
  {
    date: "Enero 2022 - Noviembre 2024",
    title: "Operador y Programador Centro de Mecanizado",
    company: "Tacker S.R.L",
    description:
      "Encargado de la programación, configuración y operación de centros de mecanizado CNC, asegurando precisión y eficiencia en la fabricación de piezas. Llegué a ser operador oficial, optimizando procesos y mejorando tiempos de producción."
  },
  {
    date: "Julio 2021 - Julio 2022",
    title: "Operador y Programador de Torno CNC",
    company: "Tacker S.R.L",
    description:
      "Responsable de la programación, configuración y operación de tornos CNC, asegurando precisión en la fabricación de piezas.",
  },
]
---

<ol class="relative mt-10">
  {
    EXPERIENCE.map((experience) => (
      <li class="">
        <ExperienceItem {...experience} />
      </li>
    ))
  }
</ol>
