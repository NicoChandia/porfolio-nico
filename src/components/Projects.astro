---
import GitHub from "./icons/GitHub.astro"
import NextJS from "./icons/NextJS.astro"
import Tailwind from "./icons/Tailwind.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Vite from "./icons/Vite.astro"
import React from "./icons/React.astro"
import MongoDb from "./icons/MongoDb.astro"
import Expressjs from "./icons/Expressjs.astro"
import Angular from "./icons/Angular.astro"
import Nodejs from "./icons/Nodejs.astro"
import Python from "./icons/Python.astro"
import HTML from "./icons/HTML.astro"
import Js from "./icons/Js.astro"
import N8N from "./icons/N8N.astro"
import Postg from "./icons/Postg.astro"

const TAGS = {
  JS: {
    name: "JavaScript",
    class: "bg-[#003159] text-white",
    icon: Js,
  },
  HTML: {
    name: "HTML",
    class: "bg-[#003159] text-white",
    icon: HTML,
  },
  PYTHON: {
    name: "Python",
    class: "bg-[#003159] text-white",
    icon: Python,
  },
  NEXT: {
    name: "Next.js",
    class: "bg-black text-white",
    icon: NextJS,
  },
  TAILWIND: {
    name: "Tailwind CSS",
    class: "bg-[#003159] text-white",
    icon: Tailwind,
  },
  VITE: {
    name: "Vite",
    class: "bg-[#003159] text-white",
    icon: Vite,
  },
  REACT: {
    name: "React",
    class: "bg-[#003159] text-white",
    icon: React,
  },
  MONGODB: {
    name: "MongoDb",
    class: "bg-[#003159] text-white",
    icon: MongoDb,
  },
  EXPRESSJS: {
    name: "Express.js",
    class: "bg-[#003159] text-white",
    icon: Expressjs,
  },
  ANGULAR: {
    name: "Angular",
    class: "bg-[#003159] text-white",
    icon: Angular,
  },
  NODEJS:{
    name: "Node.js",
    class: "bg-[#003159] text-white",
    icon: Nodejs,
  },
  N8N:{
    name: "N8N",
    class: "bg-[#003159] text-white",
    icon: N8N,
  },
  POSTGR:{
    name: "PostgreSQL",
    class: "bg-[#003159] text-white",
    icon: Postg,
  }
}

type Tag = (typeof TAGS)[keyof typeof TAGS]

interface Project {
  title: string
  description: string
  image: string
  tags: Tag[]
  github?: string
  backend?: string // si está, el botón de github se llama "Frontend"
  link?: string
}

const PROJECTS: Project[] = [
{
    title: "LeadPing",
    description:
      "LeadPing es un sistema inteligente de captación de leads. Cuando un usuario completa el formulario de contacto, n8n orquesta todo el flujo automáticamente: registra los datos en PostgreSQL y Google Sheets, notifica a la empresa vía Telegram en tiempo real, y un agente de IA responde al correo del interesado de forma personalizada según su consulta.",
    link: "https://leadping-frontend-production.up.railway.app/",
    github: "https://github.com/NicoChandia/1erFrontend-Antigravity",
    image: "/projects/leadping.webp",
    tags: [TAGS.ANGULAR, TAGS.N8N, TAGS.POSTGR],
  },
  {
    title: "Generator Image",
    description:
      "Generator Image usa modelos de inteligencia artificial de Hugging Face (la plataforma líder en IA open-source) para generar imágenes profesionales desde texto. ¡Escribe, crea y comparte en segundos!",
    link: "https://nicochandia.github.io/frontend-img-generator/",
    github: "https://github.com/NicoChandia/frontend-img-generator",
    backend: "https://github.com/NicoChandia/backend-img-generator",
    image: "/projects/gatitos.webp",
    tags: [TAGS.PYTHON, TAGS.HTML, TAGS.JS],
  },
  {
    title: "Weather App",
    description:
      "WeatherWise es una aplicación meteorológica que proporciona pronósticos precisos con una interfaz intuitiva. Utiliza la API de OpenWeatherMap para ofrecer datos en tiempo real y ayudarte a planificar actividades al aire libre.",
    link: "https://weather-app-nu-jade-30.vercel.app/",
    github: "https://github.com/NicoChandia/weather-app",
    image: "/projects/foto3.webp",
    tags: [TAGS.REACT, TAGS.VITE, TAGS.TAILWIND],
  },
  {
    title: "ProductFlow",
    description:
      "ProductFlow es una aplicación CRUD desarrollada con el stack MERN que permite gestionar productos en tiempo real. Su panel intuitivo facilita crear, visualizar, actualizar y eliminar artículos rápidamente, con una interfaz limpia y funcionalidades ágiles. ",
      github: "https://github.com/NicoChandia/mern-deploy-railway",
      link: "https://frontend-production-d2b9.up.railway.app/",
    image: "/projects/foto2.webp",
    tags: [TAGS.REACT, TAGS.NODEJS, TAGS.MONGODB, TAGS.EXPRESSJS, TAGS.VITE],
  },
  {
    title: "Ecommerce",
    description:
      "Esta es una aplicación de comercio electrónico desarrollada con Angular 19, que consume la Fake Store API para obtener productos en tiempo real. Se enfoca en buenas prácticas como consumo de APIs REST, manejo de estados y modularización del código en Angular.",
      github: "https://github.com/NicoChandia/angular-ecommerce",
      link: "https://angular-ecommerce-iml6.onrender.com",
    image: "/projects/foto1.webp",
    tags: [TAGS.ANGULAR, TAGS.TAILWIND],
  },
]
---

<div class="grid gap-6 mt-8 sm:grid-cols-2">
  {
    PROJECTS.map(({ image, title, description, tags, link, github, backend }) => (
      <article class="flex flex-col overflow-hidden transition border group rounded-2xl border-line bg-surface hover:border-accent/50 hover:-translate-y-1">
        <div class="overflow-hidden border-b aspect-video border-line">
          <img
            alt={`Captura de ${title}`}
            class="object-cover object-top w-full h-full transition duration-500 group-hover:scale-105"
            loading="lazy"
            width="960"
            height="540"
            src={image}
          />
        </div>

        <div class="flex flex-col flex-1 p-6">
          <h3 class="text-xl font-bold">{title}</h3>
          <ul class="flex flex-wrap gap-2 mt-3">
            {tags.map((tag) => (
              <li class="flex items-center px-2.5 py-1 text-xs border rounded-full gap-x-1.5 border-line text-fg">
                <tag.icon class="size-3.5" />
                {tag.name}
              </li>
            ))}
          </ul>
          <p class="mt-4 text-sm leading-relaxed text-muted">{description}</p>
          <footer class="flex flex-wrap gap-3 pt-5 mt-auto">
            {github && (
              <LinkButton href={github}>
                <GitHub class="size-5" />
                {backend ? "Frontend" : "Código"}
              </LinkButton>
            )}
            {backend && (
              <LinkButton href={backend}>
                <GitHub class="size-5" />
                Backend
              </LinkButton>
            )}
            {link && (
              <LinkButton href={link}>
                <Link class="size-4" />
                Demo
              </LinkButton>
            )}
          </footer>
        </div>
      </article>
    ))
  }
</div>
