---
const { primary, ...props } = Astro.props
const base =
  "inline-flex items-center justify-center gap-2 px-5 py-3 text-[15px] font-semibold transition rounded-xl border focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-bg"
const variant = primary
  ? "bg-accent text-on-accent border-accent hover:brightness-110"
  : "bg-surface text-fg border-line hover:border-accent/60 hover:text-accent"
const external = typeof props.href === "string" && props.href.startsWith("http")
---

<a
  {...props}
  {...(external ? { target: "_blank", rel: "noopener noreferrer" } : {})}
  class={`${base} ${variant}`}
>
  <slot />
</a>
