---
const { href } = Astro.props
---

<a
  target="_blank"
  rel="noopener noreferrer"
  href={href}
  class="inline-flex items-center justify-center gap-2 px-3 py-2 text-sm font-semibold transition border rounded-xl max-w-fit bg-surface text-fg border-line hover:border-accent/60 hover:text-accent focus:outline-none focus-visible:ring-2 focus-visible:ring-accent"
>
  <slot />
</a>
