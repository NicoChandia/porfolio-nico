---


interface Props {
  title: string
  company: string
  description: string
  date: string
  bullets?: string[]
}

const { title, company, description, date, bullets } = Astro.props
---

<div
  class="relative mx-12 pb-12 grid before:absolute before:left-[-35px] before:block before:h-full before:border-l-2 before:border-line before:content-[''] md:grid-cols-5 md:gap-10 md:space-x-4"
>
  <div class="relative pb-4 md:pb-12 md:col-span-2">
    <div class="sticky top-0">
      <span class="absolute -left-[41px] top-2 size-3 rounded-full bg-accent ring-4 ring-bg"></span>

      <h3 class="text-xl font-bold text-accent">{title}</h3>
      <h4 class="text-lg font-semibold text-fg">{company}</h4>
      <time class="font-mono text-sm text-muted">{date}</time>
    </div>
  </div>
  <div class="relative flex flex-col gap-2 pb-4 leading-relaxed text-muted md:col-span-3">
    <p>{description}</p>
    {bullets && (
      <ul class="pl-5 space-y-2 list-disc marker:text-accent [&_strong]:font-semibold [&_strong]:text-fg">
        {bullets.map((item) => <li set:html={item} />)}
      </ul>
    )}
    { /*
      link && (
        <LinkInline href={link}>
          Saber más{" "}
          <svg
            xmlns="http://www.w3.org/2000/svg"
            class="w-5 icon icon-tabler icon-tabler-chevron-right"
            width="24"
            height="24"
            viewBox="0 0 24 24"
            stroke-width="2"
            stroke="currentColor"
            fill="none"
            stroke-linecap="round"
            stroke-linejoin="round"
          >
            <>
              <path stroke="none" d="M0 0h24v24H0z" fill="none" />
              <path d="M9 6l6 6l-6 6" />
            </>
          </svg>
        </LinkInline>
      )
        */
    }
  </div>
</div>
