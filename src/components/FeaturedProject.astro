---
import GitHub from "./icons/GitHub.astro"
import Link from "./icons/Link.astro"
import LinkButton from "./LinkButton.astro"
import Angular from "./icons/Angular.astro"
import Python from "./icons/Python.astro"
import SimpleIcon from "./icons/SimpleIcon.astro"
import { siBootstrap, siFastapi, siUltralytics } from "simple-icons"

/*
  Proyecto destacado. Cuando tengas material real:
  - video: ruta a un .mp4/.webm corto en /public/projects (ej: "/projects/contador.mp4").
    Se reproduce en loop, sin sonido. Si está vacío se muestra la ilustración.
  - poster: imagen que se ve mientras carga el video (o si no hay video).
  - github: link al repo. backend / frontend: links a cada parte (opcionales).
  - demo: link a una versión desplegada (opcional).
  Cada botón aparece solo si tiene link.
*/
const REPO = "https://github.com/NicoChandia/contador-frutas"

const PROJECT = {
  title: "Contador de frutas",
  description:
    "Cuenta fruta en la cinta de un empaque en tiempo real con visión por computadora. Detecta y sigue cada fruta con un modelo YOLO26 entrenado por mí y la cuenta una sola vez al cruzar la línea: 120 de 120 en la prueba con total conocido. Un dashboard en Angular muestra la producción al instante. Próximo paso: clasificar la fruta sana y la defectuosa.",
  tags: [
    { name: "Python", icon: Python },
    { name: "YOLO26", si: siUltralytics },
    { name: "FastAPI", si: siFastapi },
    { name: "Angular", icon: Angular },
    { name: "Bootstrap", si: siBootstrap },
  ],
  video: "/projects/contador.mp4",
  poster: "/projects/contador-poster.webp",
  github: REPO,
  // backend / frontend: solo si el proyecto tiene repos separados (este es un monorepo)
  backend: "",
  frontend: "",
  demo: "https://contador-frutas-demo.vercel.app",
}

const { title, description, tags, video, poster, github, backend, frontend, demo } = PROJECT
---

<article
  class="grid overflow-hidden border md:grid-cols-[1.2fr_1fr] rounded-2xl border-line bg-surface"
>
  <div class="relative min-h-[240px] md:min-h-[300px] bg-[#2a2319] overflow-hidden">
    {
      video ? (
        <>
          <video
            id="featured-video"
            class="absolute inset-0 object-cover object-top w-full h-full"
            poster={poster || undefined}
            aria-label={`Video del ${title} funcionando: detecta cada fruta en la cinta y el contador sube en vivo`}
            muted
            loop
            playsinline
            preload="metadata"
          >
            {/* MP4 (H.264) lo reproducen casi todos; WebM es el respaldo para navegadores sin H.264 */}
            <source src={video} type="video/mp4" />
            <source src={video.replace(/\.mp4$/, ".webm")} type="video/webm" />
          </video>
          <button
            id="featured-video-toggle"
            type="button"
            class="absolute flex items-center gap-1.5 px-3 py-1.5 text-xs font-semibold text-white transition rounded-full bottom-3 right-3 bg-black/65 hover:bg-black/80"
          >
            <span data-label>Pausar</span>
          </button>
        </>
      ) : poster ? (
        <img class="absolute inset-0 object-cover object-left-top w-full h-full" src={poster} alt={`Dashboard de ${title}: video de la cinta con cada fruta detectada y contadores en vivo`} width="1200" height="619" loading="lazy" />
      ) : (
        <div class="absolute inset-0" aria-hidden="true">
          <div class="absolute inset-x-0 top-1/2 h-[42%] -translate-y-1/2 belt"></div>
          {[18, 48, 76].map((left, i) => (
            <div class="absolute apple-wrap" style={`left:${left}%; top:50%; animation-delay:${-i * 2.2}s`}>
              <div class="apple"></div>
              <div class="absolute -inset-2 border-2 border-accent">
                <span class="absolute -top-5 -left-0.5 bg-accent text-on-accent font-mono text-[10px] font-semibold px-1 whitespace-nowrap">
                  manzana {[0.94, 0.91, 0.97][i]}
                </span>
              </div>
            </div>
          ))}
          <div class="absolute px-3 py-2 font-mono text-sm font-semibold rounded top-3 right-3 bg-black/65 text-[#86efac]">
            TOTAL: 1.284
          </div>
          <span class="absolute font-mono text-[10px] bottom-2 left-3 text-white/70">ilustración</span>
        </div>
      )
    }
  </div>

  <div class="flex flex-col p-7 md:p-8">
    <span class="font-mono text-sm font-semibold tracking-[0.08em] uppercase text-accent">
      Proyecto destacado · en desarrollo
    </span>
    <h3 class="mt-3 mb-3 text-3xl font-bold tracking-tight">{title}</h3>
    <p class="leading-relaxed text-muted">{description}</p>
    <ul class="flex flex-wrap gap-2 mt-5">
      {tags.map((tag) => (
        <li class="flex items-center px-3 py-1 text-xs border rounded-full gap-x-1.5 border-line text-fg">
          {tag.icon && <tag.icon class="size-3.5" />}
          {tag.si && <SimpleIcon icon={tag.si} class="size-3.5" />}
          {tag.name}
        </li>
      ))}
    </ul>
    {(github || backend || frontend || demo) && (
      <footer class="flex flex-wrap gap-3 pt-6 mt-auto">
        {github && (
          <LinkButton href={github}>
            <GitHub class="size-5" />
            Código
          </LinkButton>
        )}
        {backend && (
          <LinkButton href={backend}>
            <GitHub class="size-5" />
            Backend
          </LinkButton>
        )}
        {frontend && (
          <LinkButton href={frontend}>
            <GitHub class="size-5" />
            Frontend
          </LinkButton>
        )}
        {demo && (
          <LinkButton href={demo}>
            <Link class="size-4" />
            Demo
          </LinkButton>
        )}
      </footer>
    )}
  </div>
</article>

<script>
  // El video se reproduce solo, salvo que la persona pida "reducir movimiento" en su sistema.
  // El botón permite pausarlo siempre (WCAG 2.2.2).
  document.addEventListener("astro:page-load", () => {
    const video = document.getElementById("featured-video") as HTMLVideoElement | null
    const btn = document.getElementById("featured-video-toggle")
    if (!video || !btn) return
    const label = btn.querySelector("[data-label]")!
    const sync = () => {
      label.textContent = video.paused ? "Reproducir" : "Pausar"
    }
    btn.addEventListener("click", () => (video.paused ? video.play() : video.pause()))
    video.addEventListener("play", sync)
    video.addEventListener("pause", sync)
    if (!matchMedia("(prefers-reduced-motion: reduce)").matches) video.play().catch(() => {})
    sync()
  })
</script>

<style>
  .belt {
    background: repeating-linear-gradient(90deg, #2b2b2b 0 38px, #333 38px 40px);
    animation: belt 1.2s linear infinite;
  }
  .apple-wrap {
    width: 56px;
    height: 56px;
    margin-top: -28px;
  }
  .apple {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: radial-gradient(circle at 35% 35%, #e05050, #8f1d1d);
  }
  @keyframes belt {
    to {
      background-position: 40px 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .belt {
      animation: none;
    }
  }
</style>
