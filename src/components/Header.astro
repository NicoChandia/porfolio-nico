---
import ThemeToggle from "./ThemeToggle.astro"

const navItems = [
  { title: "Proyectos", label: "proyectos", url: "/#proyectos" },
  { title: "Experiencia", label: "experiencia", url: "/#experiencia" },
  { title: "Cursos", label: "cursos", url: "/#cursos" },
  { title: "Sobre mí", label: "sobre-mi", url: "/#sobre-mi" },
  { title: "Contacto", label: "contacto", url: "/#contacto" },
]
---

<header class="fixed top-0 z-10 w-full px-2 pt-3 pb-4 sm:px-4">
  <!-- Degradé para que el contenido se desvanezca al pasar por debajo del menú -->
  <div aria-hidden="true" class="absolute inset-0 pointer-events-none -z-10 bg-gradient-to-b from-bg via-bg/80 to-transparent"></div>
  <div class="flex items-center justify-center mx-auto md:justify-between max-w-5xl">
    <a href="/" class="hidden px-4 py-1.5 text-lg font-bold tracking-tight border rounded-full shadow-lg md:block bg-surface/90 border-line backdrop-blur-xl">
      nico<span class="text-accent">.</span>dev
    </a>
    <nav
      aria-label="Secciones"
      class="flex items-center px-2 text-xs font-medium border rounded-full shadow-lg sm:px-3 sm:text-sm text-muted bg-surface/90 border-line backdrop-blur-xl"
    >
      {
        navItems.map((link) => (
          <a
            class="relative block px-1 py-2 transition sm:px-2 whitespace-nowrap hover:text-accent"
            data-section={link.label}
            href={link.url}
          >
            {link.title}
          </a>
        ))
      }
      <ThemeToggle />
    </nav>
  </div>
</header>

<script>
  document.addEventListener("astro:page-load", () => {
    const sections = document.querySelectorAll("section")
    const navItems = document.querySelectorAll<HTMLAnchorElement>("header nav a")

    const callback = (entries: IntersectionObserverEntry[]) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          navItems.forEach((item) => {
            item.classList.toggle("text-accent", item.dataset.section === entry.target.id)
          })
        }
      })
    }

    // Marca la sección que cruza la franja central de la pantalla
    // (funciona bien aunque la sección sea más alta que la pantalla)
    const observer = new IntersectionObserver(callback, {
      root: null,
      rootMargin: "-45% 0px -50% 0px",
      threshold: 0,
    })

    sections.forEach((section) => observer.observe(section))

    document.onvisibilitychange = () => {
      if (document.visibilityState === "hidden") {
        observer.disconnect()
      } else {
        sections.forEach((section) => observer.observe(section))
      }
    }
  })
</script>
